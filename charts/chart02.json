{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "One hundred percent stacked bar of the reported source used to fund respondents' latest veterinary emergency.",
  "title": "Funding for the latest veterinary emergency",
  "data": { "url": "../data/survey_observations.csv", "format": { "type": "csv" } },
  "transform": [
    { "filter": "datum.source_id === 'S03' && datum.section === 'emergency_funding'" },
    { "calculate": "toNumber(datum.percentage)", "as": "share" },
    { "calculate": "datum.category === 'Personal savings' ? 0 : datum.category === 'Dedicated pet fund' ? 1 : 2", "as": "fund_order" },
    { "calculate": "'Latest emergency'", "as": "question" },
    { "stack": "share", "groupby": ["question"], "sort": [{ "field": "fund_order", "order": "ascending" }], "as": ["stack_start", "stack_end"] },
    { "calculate": "(datum.stack_start + datum.stack_end) / 2", "as": "stack_mid" },
    { "calculate": "format(datum.share, '.0f') + '%'", "as": "share_label" },
    { "calculate": "datum.category === 'Personal savings' ? 'Personal savings' : datum.category === 'Dedicated pet fund' ? 'Dedicated pet fund' : 'Pet insurance'", "as": "fund_label" }
  ],
  "width": "container",
  "height": 125,
  "layer": [
    {
      "mark": { "type": "bar", "height": 78 },
      "encoding": {
        "x": { "field": "stack_start", "type": "quantitative", "scale": { "domain": [0, 108], "nice": false }, "axis": { "title": "Share of responses (%)", "values": [0, 20, 40, 60, 80, 100], "grid": true } },
        "x2": { "field": "stack_end" },
        "y": { "field": "question", "type": "nominal", "axis": null },
        "color": { "field": "fund_label", "type": "nominal", "title": "Funding source", "sort": ["Personal savings", "Dedicated pet fund", "Pet insurance"], "scale": { "domain": ["Personal savings", "Dedicated pet fund", "Pet insurance"], "range": ["#1D4F7A", "#8FB7D2", "#D99A32"] }, "legend": { "orient": "bottom", "direction": "horizontal" } },
        "tooltip": [
          { "field": "fund_label", "type": "nominal", "title": "Funding source" },
          { "field": "share", "type": "quantitative", "title": "Share", "format": ".0f", "formatType": "number" },
          { "field": "base", "type": "nominal", "title": "Question base" }
        ]
      }
    },
    {
      "transform": [{ "filter": "datum.share >= 8" }],
      "mark": { "type": "text", "align": "center", "baseline": "middle", "fontSize": 17, "fontWeight": 700, "color": "#FFFFFF" },
      "encoding": {
        "x": { "field": "stack_mid", "type": "quantitative", "scale": { "domain": [0, 108], "nice": false } },
        "y": { "field": "question", "type": "nominal", "axis": null },
        "text": { "field": "share_label", "type": "nominal" }
      }
    },
    {
      "transform": [{ "filter": "datum.share < 8" }],
      "mark": { "type": "text", "align": "left", "baseline": "middle", "dx": 7, "fontSize": 15, "fontWeight": 700, "color": "#24364B" },
      "encoding": {
        "x": { "field": "stack_end", "type": "quantitative", "scale": { "domain": [0, 108], "nice": false } },
        "y": { "field": "question", "type": "nominal", "axis": null },
        "text": { "field": "share_label", "type": "nominal" }
      }
    }
  ],
  "config": {
    "axis": { "labelFont": "Arial", "titleFont": "Arial", "labelFontSize": 13, "titleFontSize": 14, "labelColor": "#536678", "titleColor": "#24364B", "domainColor": "#D8E0E7", "tickColor": "#D8E0E7", "gridColor": "#E8EDF2" },
    "legend": { "labelFont": "Arial", "titleFont": "Arial", "labelFontSize": 13, "titleFontSize": 13, "labelColor": "#536678", "titleColor": "#24364B" },
    "view": { "stroke": null }
  }
}
