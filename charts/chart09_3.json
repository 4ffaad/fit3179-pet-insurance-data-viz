{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small-multiple dot plots compare monetary benefit limits stated on current policy pages. A zero is explicitly not covered; no point means the product page did not list that benefit.",
  "title": "Published monetary limits by benefit",
  "data": {
    "url": "../data/insurance_evidence.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "filter": "datum.record_type === 'policy_detail' && (datum.benefit === 'Vet / surgical annual limit' || datum.benefit === 'Death due to injury / illness' || datum.benefit === 'Burial / cremation' || datum.benefit === 'Advertising / reward for missing pet' || datum.benefit === 'Boarding kennel / cattery' || datum.benefit === 'Third-party liability')"
    },
    {
      "calculate": "datum.provider === 'MSIG Direct' ? 'MSIG Direct ' + datum.plan : datum.provider + ' ' + datum.plan",
      "as": "policy_label"
    },
    {
      "calculate": "datum.benefit === 'Vet / surgical annual limit' ? 'Veterinary and surgery' : datum.benefit === 'Death due to injury / illness' ? 'Death benefit' : datum.benefit === 'Burial / cremation' ? 'Burial and cremation' : datum.benefit === 'Advertising / reward for missing pet' ? 'Reward for missing pet' : datum.benefit === 'Boarding kennel / cattery' ? 'Boarding' : 'Third-party liability'",
      "as": "benefit_label"
    },
    {"calculate": "toNumber(datum.value_numeric)", "as": "limit_rm"},
    {"calculate": "datum.pet_type === 'Cat/Dog' ? 'Cat and dog' : datum.pet_type", "as": "pet_label"},
    {"calculate": "datum.value_text === 'Not covered' ? 'Not covered' : 'Published limit'", "as": "limit_status"}
  ],
  "facet": {
    "field": "benefit_label",
    "type": "nominal",
    "sort": [
      "Veterinary and surgery",
      "Death benefit",
      "Burial and cremation",
      "Reward for missing pet",
      "Boarding",
      "Third-party liability"
    ],
    "header": {
      "title": null,
      "labelFont": "Georgia",
      "labelFontSize": 16,
      "labelFontWeight": 700,
      "labelColor": "#1D4F7A",
      "labelPadding": 8,
      "labelOrient": "top"
    }
  },
  "columns": 2,
  "spec": {
    "width": 510,
    "height": 145,
    "mark": {"type": "point", "filled": true, "size": 230, "stroke": "#FFFFFF", "strokeWidth": 1.5},
    "encoding": {
      "x": {
        "field": "limit_rm",
        "type": "quantitative",
        "scale": {"zero": true, "nice": true},
        "axis": {"title": "Maximum benefit (ringgit)", "format": ",.0f", "tickCount": 4, "labelFontSize": 11, "titleFontSize": 11}
      },
      "y": {
        "field": "policy_label",
        "type": "nominal",
        "sort": ["Oyen Basic", "Oyen Plus", "Oyen Champion", "MSIG Direct Plan 1", "MSIG Direct Plan 2", "MSIG Direct Plan 3"],
        "axis": {"title": null, "labelFontSize": 12, "labelLimit": 150, "labelPadding": 5, "ticks": false, "domain": false}
      },
      "color": {
        "field": "limit_status",
        "type": "nominal",
        "title": "Published status",
        "scale": {"domain": ["Published limit", "Not covered"], "range": ["#3976A8", "#D99A32"]},
        "legend": {"orient": "bottom", "direction": "horizontal", "symbolSize": 130}
      },
      "shape": {
        "field": "pet_label",
        "type": "nominal",
        "title": "Pet type in source",
        "scale": {"domain": ["Cat and dog", "Cat", "Dog"], "range": ["square", "circle", "triangle-up"]},
        "legend": {"orient": "bottom", "direction": "horizontal", "symbolSize": 100}
      },
      "tooltip": [
        {"field": "policy_label", "type": "nominal", "title": "Plan"},
        {"field": "benefit_label", "type": "nominal", "title": "Benefit"},
        {"field": "pet_label", "type": "nominal", "title": "Pet type"},
        {"field": "limit_rm", "type": "quantitative", "title": "Published limit (ringgit)", "format": ",.0f"},
        {"field": "limit_status", "type": "nominal", "title": "Status"}
      ]
    }
  },
  "resolve": {"scale": {"x": "independent", "y": "shared", "color": "shared", "shape": "shared"}},
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {"labelColor": "#536678", "titleColor": "#24364B", "gridColor": "#E8EDF2", "domainColor": "#D8E0E7", "tickColor": "#D8E0E7"},
    "legend": {"labelFont": "Arial", "titleFont": "Arial", "labelFontSize": 12, "titleFontSize": 12, "labelColor": "#536678", "titleColor": "#24364B"},
    "title": {"font": "Georgia", "fontSize": 19, "fontWeight": 700, "anchor": "start", "color": "#1D4F7A", "offset": 10}
  }
}
