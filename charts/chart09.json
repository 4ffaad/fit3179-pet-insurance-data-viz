{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A dot matrix compares six published plans across six benefits. Colour distinguishes included cover, benefits that vary by pet, benefits explicitly not covered, and benefits not listed on the product page. Click a plan to focus its row; hover for the published wording.",
  "title": "Benefits listed across insurance plans",
  "data": {
    "url": "../data/insurance_evidence.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"filter": "datum.record_type === 'coverage_cell'"},
    {
      "calculate": "datum.provider === 'MSIG Direct' ? 'MSIG Direct ' + datum.plan : datum.provider + ' ' + datum.plan",
      "as": "policy_label"
    },
    {
      "calculate": "datum.benefit === 'Veterinary / surgery limit' ? 'Veterinary and surgery limit' : datum.benefit === 'Burial / cremation' ? 'Burial and cremation' : datum.benefit === 'Missing-pet reward' ? 'Reward for missing pet' : datum.benefit === 'Third-party liability' ? 'Third-party liability' : datum.benefit",
      "as": "benefit_label"
    },
    {
      "calculate": "datum.coverage_status === 'Partial' ? 'Varies by pet' : datum.coverage_status",
      "as": "status_label"
    }
  ],
  "params": [
    {
      "name": "plan_focus",
      "select": {"type": "point", "fields": ["policy_label"], "toggle": true}
    }
  ],
  "width": 1080,
  "height": 390,
  "mark": {
    "type": "circle",
    "size": 230,
    "stroke": "#FFFFFF",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "policy_label",
      "type": "nominal",
      "sort": [
        "Oyen Basic",
        "Oyen Plus",
        "Oyen Champion",
        "MSIG Direct Plan 1",
        "MSIG Direct Plan 2",
        "MSIG Direct Plan 3"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelPadding": 12,
        "labelLimit": 180,
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "benefit_label",
      "type": "nominal",
      "sort": [
        "Veterinary and surgery limit",
        "Death benefit",
        "Burial and cremation",
        "Reward for missing pet",
        "Boarding",
        "Third-party liability"
      ],
      "axis": {
        "title": null,
        "labelAlign": "right",
        "labelPadding": 12,
        "labelLimit": 210,
        "ticks": false,
        "domain": false
      }
    },
    "color": {
      "field": "status_label",
      "type": "nominal",
      "title": "Product-page status",
      "sort": ["Included", "Varies by pet", "Not covered", "Not listed"],
      "scale": {
        "domain": ["Included", "Varies by pet", "Not covered", "Not listed"],
        "range": ["#3976A8", "#D99A32", "#7A8792", "#D8DEE6"]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleFont": "Arial",
        "labelFont": "Arial",
        "labelLimit": 180,
        "symbolSize": 150
      }
    },
    "opacity": {
      "condition": {"param": "plan_focus", "empty": true, "value": 1},
      "value": 0.2
    },
    "tooltip": [
      {"field": "policy_label", "type": "nominal", "title": "Plan"},
      {"field": "benefit_label", "type": "nominal", "title": "Benefit"},
      {"field": "status_label", "type": "nominal", "title": "Product-page status"},
      {"field": "display", "type": "nominal", "title": "Published wording"}
    ]
  },
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#536678",
      "titleColor": "#24364B",
      "domainColor": "#D8E0E7",
      "tickColor": "#D8E0E7",
      "grid": false
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#536678",
      "titleColor": "#24364B"
    },
    "title": {
      "font": "Georgia",
      "fontSize": 19,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#1D4F7A",
      "offset": 10
    }
  }
}
