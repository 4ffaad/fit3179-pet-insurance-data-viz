{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Distribution of stated acceptable annual pet-insurance price bands among 116 respondents in a Selangor study.",
  "title": "Annual price expectations",
  "data": {
    "url": "../data/survey_observations.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.source_id === 'S01T' && datum.section === 'price'"
    },
    {
      "calculate": "format(toNumber(datum.percentage), '.1f') + '%'",
      "as": "share_label"
    },
    {
      "calculate": "datum.category === 'Less than RM200 per year' ? 'Under 200 ringgit a year' : datum.category === 'RM200–399 per year' ? '200 to 399 ringgit a year' : datum.category === 'RM400–599 per year' ? '400 to 599 ringgit a year' : datum.category === 'RM600–799 per year' ? '600 to 799 ringgit a year' : datum.category === 'More than RM800 per year' ? 'Above 800 ringgit a year' : datum.category",
      "as": "price_band_label"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Georgia",
      "fontSize": 19,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#1D4F7A",
      "offset": 10
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#536678",
      "titleColor": "#24364B",
      "domainColor": "#D8E0E7",
      "tickColor": "#D8E0E7",
      "gridColor": "#E8EDF2",
      "gridOpacity": 0.68
    },
    "font": "Arial",
    "text": {
      "font": "Arial",
      "color": "#24364B"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#536678",
      "titleColor": "#24364B"
    }
  },
  "hconcat": [
    {
      "width": 190,
      "height": 320,
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "label_count"
            }
          ],
          "groupby": [
            "price_band_label"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Arial",
        "fontSize": 14,
        "color": "#536678",
        "limit": 186
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "field": "price_band_label",
          "type": "ordinal",
          "sort": [
            "Under 200 ringgit a year",
            "200 to 399 ringgit a year",
            "400 to 599 ringgit a year",
            "600 to 799 ringgit a year",
            "Above 800 ringgit a year",
            "Not willing to spend"
          ],
          "axis": null
        },
        "text": {
          "field": "price_band_label",
          "type": "ordinal"
        }
      }
    },
    {
      "width": 318,
      "height": 320,
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#3976A8",
            "height": 20,
            "cornerRadiusEnd": 2
          },
          "encoding": {
            "x": {
              "field": "percentage",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  45
                ],
                "nice": false
              },
              "axis": {
                "title": "Respondents (%)",
                "values": [
                  0,
                  10,
                  20,
                  30,
                  40
                ],
                "format": ".0f"
              }
            },
            "tooltip": [
              {
                "field": "price_band_label",
                "type": "nominal",
                "title": "Stated annual price"
              },
              {
                "field": "count",
                "type": "quantitative",
                "title": "Respondents",
                "format": ",.0f"
              },
              {
                "field": "percentage",
                "type": "quantitative",
                "title": "Share of sample",
                "format": ".1f"
              },
              {
                "field": "base_n",
                "type": "quantitative",
                "title": "Sample size",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 6,
            "font": "Arial",
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#1D4F7A"
          },
          "encoding": {
            "x": {
              "field": "percentage",
              "type": "quantitative"
            },
            "text": {
              "field": "share_label",
              "type": "nominal"
            }
          }
        }
      ],
      "encoding": {
        "y": {
          "field": "price_band_label",
          "type": "ordinal",
          "sort": [
            "Under 200 ringgit a year",
            "200 to 399 ringgit a year",
            "400 to 599 ringgit a year",
            "600 to 799 ringgit a year",
            "Above 800 ringgit a year",
            "Not willing to spend"
          ],
          "axis": null
        }
      }
    }
  ],
  "spacing": 12,
  "resolve": {
    "scale": {
      "y": "shared"
    }
  }
}
