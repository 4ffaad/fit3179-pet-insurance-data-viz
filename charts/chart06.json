{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected scatterplot of current annual MSIG Direct premiums and veterinary or surgery cover limits for cat and dog plans.",
  "title": "Annual MSIG premium and veterinary cover",
  "data": { "url": "../data/insurance_evidence.csv", "format": { "type": "csv" } },
  "transform": [
    { "filter": "datum.source_id === 'S07' && datum.record_type === 'policy_detail' && datum.provider === 'MSIG Direct' && datum.benefit === 'Annual premium'" },
    { "calculate": "datum.plan === 'Plan 1' ? 1 : datum.plan === 'Plan 2' ? 2 : 3", "as": "plan_order" },
    { "calculate": "toNumber(datum.value_numeric)", "as": "annual_premium" },
    { "calculate": "datum.plan === 'Plan 1' ? 2000 : datum.plan === 'Plan 2' ? 3500 : 5000", "as": "annual_vet_limit" }
  ],
  "width": "container",
  "height": 430,
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 3 },
      "encoding": {
        "x": { "field": "annual_premium", "type": "quantitative", "scale": { "domain": [500, 1275], "nice": false }, "axis": { "title": "Annual premium (ringgit)", "format": ",.0f", "tickCount": 6, "labelFontSize": 14, "titleFontSize": 15 } },
        "y": { "field": "annual_vet_limit", "type": "quantitative", "scale": { "domain": [1500, 5500], "nice": false }, "axis": { "title": "Annual veterinary and surgery limit (ringgit)", "format": ",.0f", "tickCount": 5, "labelFontSize": 14, "titleFontSize": 15 } },
        "color": { "field": "pet_type", "type": "nominal", "title": "Pet type", "scale": { "domain": ["Cat", "Dog"], "range": ["#3976A8", "#D99A32"] }, "legend": { "orient": "bottom", "direction": "horizontal" } },
        "detail": { "field": "pet_type" },
        "order": { "field": "plan_order", "type": "quantitative" }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 190, "stroke": "#FFFFFF", "strokeWidth": 1.5 },
      "encoding": {
        "x": { "field": "annual_premium", "type": "quantitative", "scale": { "domain": [500, 1275], "nice": false } },
        "y": { "field": "annual_vet_limit", "type": "quantitative", "scale": { "domain": [1500, 5500], "nice": false } },
        "color": { "field": "pet_type", "type": "nominal", "title": "Pet type", "scale": { "domain": ["Cat", "Dog"], "range": ["#3976A8", "#D99A32"] } },
        "shape": { "field": "plan", "type": "nominal", "title": "Plan tier", "sort": ["Plan 1", "Plan 2", "Plan 3"], "scale": { "domain": ["Plan 1", "Plan 2", "Plan 3"], "range": ["circle", "square", "diamond"] }, "legend": { "orient": "bottom", "direction": "horizontal" } },
        "tooltip": [
          { "field": "pet_type", "type": "nominal", "title": "Pet type" },
          { "field": "plan", "type": "nominal", "title": "Plan" },
          { "field": "annual_premium", "type": "quantitative", "title": "Annual premium (RM)", "format": ",.2f" },
          { "field": "annual_vet_limit", "type": "quantitative", "title": "Annual veterinary and surgery limit (RM)", "format": ",.0f" }
        ]
      }
    }
  ],
  "resolve": { "scale": { "color": "shared" } },
  "config": {
    "font": "Arial",
    "axis": { "labelFont": "Arial", "titleFont": "Arial", "labelColor": "#536678", "titleColor": "#24364B", "domainColor": "#D8E0E7", "tickColor": "#D8E0E7", "gridColor": "#E8EDF2", "gridOpacity": 0.75 },
    "title": { "font": "Georgia", "fontSize": 21, "fontWeight": 700, "anchor": "start", "color": "#1D4F7A", "offset": 12 },
    "legend": { "labelFont": "Arial", "titleFont": "Arial", "labelFontSize": 13, "titleFontSize": 13, "labelColor": "#536678", "titleColor": "#24364B" },
    "view": { "stroke": null }
  }
}
