{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#FBFAF7",
  "config": {
    "font": "Arial",
    "background": "#FBFAF7",
    "title": {
      "font": "Georgia",
      "fontSize": 22,
      "fontWeight": "normal",
      "anchor": "start",
      "color": "#173A52",
      "subtitleFont": "Arial",
      "subtitleFontSize": 13,
      "subtitleColor": "#687988",
      "offset": 14
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#5B6F7E",
      "titleColor": "#334F63",
      "domainColor": "#D4DEE4",
      "tickColor": "#D4DEE4",
      "gridColor": "#E8EDF0",
      "gridOpacity": 0.9,
      "labelLimit": 260,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#536979",
      "titleColor": "#334F63",
      "orient": "top",
      "direction": "horizontal",
      "padding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Arial",
      "color": "#173A52"
    },
    "facet": {
      "spacing": 28
    }
  },
  "title": {
    "text": "Food leads pet spending, except for reptiles",
    "subtitle": "Annual averages to March 2025 \u00b7 grey \u00d7 = AMA did not report a value."
  },
  "description": "Average annual household spending by pet type and category. AMA did not publish values for all cells; a grey cross is not a zero. The residual \u201cAnything else\u201d category is excluded.",
  "data": {
    "url": "../data/ama_spend_by_pet_type_2025.csv",
    "format": {
      "type": "csv"
    }
  },
  "width": 760,
  "height": 490,
  "transform": [
    {
      "filter": "datum.spend_category !== 'Anything else'"
    },
    {
      "calculate": "datum.annual_spend_aud === \"\" ? null : toNumber(datum.annual_spend_aud)",
      "as": "spend_num"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FBFAF7",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "pet_type",
          "type": "ordinal",
          "sort": [
            "Dogs",
            "Cats",
            "Fish",
            "Birds",
            "Small mammals",
            "Reptiles"
          ],
          "axis": {
            "orient": "top",
            "title": null,
            "labelAngle": 0,
            "labelLimit": 120,
            "labelFontWeight": "bold",
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "category_label",
          "type": "ordinal",
          "sort": [
            "Food",
            "Veterinary services",
            "Products / accessories",
            "Pet insurance",
            "Flea / worm / tick",
            "Supplements",
            "Grooming",
            "Training / behaviour",
            "Competitions / memberships",
            "Veterinary medicines",
            "Walking",
            "Alternative healthcare",
            "Boarding / minding",
            "Transport",
            "Pet healthcare products"
          ],
          "axis": {
            "title": null,
            "labelLimit": 190,
            "labelFontSize": 10
          }
        },
        "color": {
          "condition": {
            "test": "isValid(datum.spend_num)",
            "field": "spend_num",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                1100
              ],
              "range": [
                "#F4F8FB",
                "#DCEAF2",
                "#B7D4E3",
                "#88B5CE",
                "#568EAE",
                "#2F6686"
              ]
            },
            "legend": {
              "title": "Spend per household (AUD)",
              "orient": "top",
              "format": "$,d"
            }
          },
          "value": "#D8D7D3"
        },
        "tooltip": [
          {
            "field": "pet_type",
            "type": "nominal",
            "title": "Pet type"
          },
          {
            "field": "spend_category",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "value_label",
            "type": "nominal",
            "title": "Published value"
          },
          {
            "field": "sample_n",
            "type": "quantitative",
            "title": "Pet owners in sample",
            "format": "d"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.value_label === 'Not reported'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 18,
        "fontWeight": "bold",
        "color": "#667681",
        "baseline": "middle",
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "pet_type",
          "type": "ordinal",
          "sort": [
            "Dogs",
            "Cats",
            "Fish",
            "Birds",
            "Small mammals",
            "Reptiles"
          ]
        },
        "y": {
          "field": "category_label",
          "type": "ordinal",
          "sort": [
            "Food",
            "Veterinary services",
            "Products / accessories",
            "Pet insurance",
            "Flea / worm / tick",
            "Supplements",
            "Grooming",
            "Training / behaviour",
            "Competitions / memberships",
            "Veterinary medicines",
            "Walking",
            "Alternative healthcare",
            "Boarding / minding",
            "Transport",
            "Pet healthcare products"
          ]
        },
        "text": {
          "value": "\u00d7"
        },
        "tooltip": [
          {
            "field": "pet_type",
            "type": "nominal",
            "title": "Pet type"
          },
          {
            "field": "spend_category",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "value_label",
            "type": "nominal",
            "title": "Published value"
          },
          {
            "field": "sample_n",
            "type": "quantitative",
            "title": "Pet owners in sample",
            "format": "d"
          }
        ]
      }
    }
  ]
}
