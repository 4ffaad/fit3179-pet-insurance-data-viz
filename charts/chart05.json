{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ordered horizontal bars of acceptable annual pet-insurance price bands reported by 116 participants in a Selangor study.",
  "title": "Annual pet insurance budget stated in the Selangor study",
  "data": { "url": "../data/survey_observations.csv", "format": { "type": "csv" } },
  "transform": [
    { "filter": "datum.source_id === 'S01T' && datum.section === 'price'" },
    { "calculate": "toNumber(datum.percentage)", "as": "share" },
    { "calculate": "datum.category === 'Not willing to spend' ? 'Not willing' : datum.category === 'Less than RM200 per year' ? 'Under RM200' : datum.category === 'RM200–399 per year' ? 'RM200–399' : datum.category === 'RM400–599 per year' ? 'RM400–599' : datum.category === 'RM600–799 per year' ? 'RM600–799' : 'Above RM800'", "as": "price_band" },
    { "calculate": "format(datum.share, '.1f') + '%'", "as": "share_label" }
  ],
  "resolve": { "scale": { "y": "shared" } },
  "hconcat": [
    {
      "width": 230,
      "height": 355,
      "transform": [{ "aggregate": [{ "op": "count", "as": "label_count" }], "groupby": ["price_band"] }],
      "mark": { "type": "text", "align": "left", "baseline": "middle", "font": "Arial", "fontSize": 14, "color": "#394F64", "limit": 225 },
      "encoding": {
        "x": { "value": 0 },
        "y": { "field": "price_band", "type": "nominal", "sort": ["Not willing", "Under RM200", "RM200–399", "RM400–599", "RM600–799", "Above RM800"], "axis": null },
        "text": { "field": "price_band", "type": "nominal" }
      }
    },
    {
      "width": 980,
      "height": 355,
      "layer": [
        {
          "mark": { "type": "bar", "color": "#3976A8", "cornerRadiusEnd": 3, "height": 30 },
          "encoding": {
            "x": { "field": "share", "type": "quantitative", "scale": { "domain": [0, 45], "nice": false }, "axis": { "title": "Share of study participants (%)", "values": [0, 10, 20, 30, 40], "labelFontSize": 14, "titleFontSize": 15 } },
            "y": { "field": "price_band", "type": "nominal", "sort": ["Not willing", "Under RM200", "RM200–399", "RM400–599", "RM600–799", "Above RM800"], "axis": null },
            "tooltip": [
              { "field": "category", "type": "nominal", "title": "Annual budget" },
              { "field": "share", "type": "quantitative", "title": "Share", "format": ".1f" },
              { "field": "count", "type": "quantitative", "title": "Participants", "format": "d" },
              { "field": "base_n", "type": "quantitative", "title": "Study base", "format": "d" }
            ]
          }
        },
        {
          "mark": { "type": "text", "align": "left", "baseline": "middle", "dx": 8, "fontSize": 14, "fontWeight": 700, "color": "#24364B" },
          "encoding": {
            "x": { "field": "share", "type": "quantitative", "scale": { "domain": [0, 45], "nice": false } },
            "y": { "field": "price_band", "type": "nominal", "sort": ["Not willing", "Under RM200", "RM200–399", "RM400–599", "RM600–799", "Above RM800"], "axis": null },
            "text": { "field": "share_label", "type": "nominal" }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Arial",
    "axis": { "labelFont": "Arial", "titleFont": "Arial", "labelColor": "#536678", "titleColor": "#24364B", "domainColor": "#D8E0E7", "tickColor": "#D8E0E7", "gridColor": "#E8EDF2", "gridOpacity": 0.8 },
    "title": { "font": "Georgia", "fontSize": 21, "fontWeight": 700, "anchor": "start", "color": "#1D4F7A", "offset": 12 },
    "view": { "stroke": null }
  }
}
