{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "One tile represents one percentage point in the share of 4,872 Malaysian pet owners reporting no dedicated financial buffer for pet emergencies.",
  "title": "Dedicated emergency fund for pets",
  "data": {
    "sequence": { "start": 0, "stop": 100, "as": "tile" }
  },
  "transform": [
    { "calculate": "'No dedicated financial buffer'", "as": "category" },
    {
      "lookup": "category",
      "from": {
        "data": { "url": "../data/survey_observations.csv", "format": { "type": "csv" } },
        "key": "category",
        "fields": ["percentage", "base"]
      },
      "as": ["source_percentage", "survey_base"]
    },
    { "calculate": "toNumber(datum.source_percentage)", "as": "buffer_share" },
    { "calculate": "datum.tile < datum.buffer_share ? 'No dedicated buffer' : 'Some dedicated buffer'", "as": "buffer_status" },
    { "calculate": "datum.tile % 20", "as": "column" },
    { "calculate": "floor(datum.tile / 20)", "as": "row" },
    { "calculate": "format(datum.buffer_share, '.0f') + '%'", "as": "share_label" }
  ],
  "width": "container",
  "height": 245,
  "mark": { "type": "rect", "cornerRadius": 3, "stroke": "#FFFFFF", "strokeWidth": 3 },
  "encoding": {
    "x": { "field": "column", "type": "ordinal", "sort": "ascending", "axis": null, "scale": { "paddingInner": 0.08, "paddingOuter": 0.02 } },
    "y": { "field": "row", "type": "ordinal", "sort": "ascending", "axis": null, "scale": { "paddingInner": 0.1, "paddingOuter": 0.02 } },
    "color": {
      "field": "buffer_status",
      "type": "nominal",
      "title": "Survey response",
      "scale": { "domain": ["No dedicated buffer", "Some dedicated buffer"], "range": ["#D99A32", "#3976A8"] },
      "legend": { "orient": "bottom", "direction": "horizontal", "symbolType": "square", "symbolSize": 140 }
    },
    "tooltip": [
      { "field": "buffer_status", "type": "nominal", "title": "Survey response" },
      { "field": "share_label", "type": "nominal", "title": "Pet owners" },
      { "field": "survey_base", "type": "nominal", "title": "Survey base" },
      { "value": "One tile represents one percentage point, not one respondent." }
    ]
  },
  "config": { "view": { "stroke": null } }
}
