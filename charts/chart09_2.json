{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A stacked bar chart counts the six benefit statuses published for each plan. Not listed and not covered remain separate categories.",
  "title": "Benefit status counts by plan",
  "data": {
    "url": "../data/insurance_evidence.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"filter": "datum.record_type === 'coverage_cell'"},
    {
      "calculate": "datum.provider === 'MSIG Direct' ? 'MSIG Direct ' + datum.plan : datum.provider + ' ' + datum.plan",
      "as": "policy_label"
    },
    {
      "calculate": "datum.coverage_status === 'Partial' ? 'Varies by pet' : datum.coverage_status",
      "as": "status_label"
    },
    {
      "aggregate": [{"op": "count", "as": "benefit_count"}],
      "groupby": ["policy_label", "status_label"]
    }
  ],
  "width": 1000,
  "height": 350,
  "mark": {"type": "bar", "cornerRadiusEnd": 3},
  "encoding": {
    "x": {
      "field": "benefit_count",
      "type": "quantitative",
      "stack": "zero",
      "scale": {"domain": [0, 6], "nice": false},
      "axis": {"title": "Number of benefit items (six per plan)", "values": [0, 1, 2, 3, 4, 5, 6], "grid": true}
    },
    "y": {
      "field": "policy_label",
      "type": "nominal",
      "sort": ["Oyen Basic", "Oyen Plus", "Oyen Champion", "MSIG Direct Plan 1", "MSIG Direct Plan 2", "MSIG Direct Plan 3"],
      "axis": {"title": null, "labelLimit": 200, "labelPadding": 10, "ticks": false, "domain": false}
    },
    "color": {
      "field": "status_label",
      "type": "nominal",
      "title": "Product-page status",
      "sort": ["Included", "Varies by pet", "Not covered", "Not listed"],
      "scale": {
        "domain": ["Included", "Varies by pet", "Not covered", "Not listed"],
        "range": ["#3976A8", "#D99A32", "#7A8792", "#D8DEE6"]
      },
      "legend": {"orient": "bottom", "direction": "horizontal", "symbolSize": 130}
    },
    "tooltip": [
      {"field": "policy_label", "type": "nominal", "title": "Plan"},
      {"field": "status_label", "type": "nominal", "title": "Product-page status"},
      {"field": "benefit_count", "type": "quantitative", "title": "Benefit items", "format": "d"}
    ]
  },
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {"labelFont": "Arial", "titleFont": "Arial", "labelFontSize": 13, "titleFontSize": 13, "labelColor": "#536678", "titleColor": "#24364B", "gridColor": "#E8EDF2", "domainColor": "#D8E0E7", "tickColor": "#D8E0E7"},
    "legend": {"labelFont": "Arial", "titleFont": "Arial", "labelFontSize": 12, "titleFontSize": 12, "labelColor": "#536678", "titleColor": "#24364B"},
    "title": {"font": "Georgia", "fontSize": 19, "fontWeight": 700, "anchor": "start", "color": "#1D4F7A", "offset": 10}
  }
}
