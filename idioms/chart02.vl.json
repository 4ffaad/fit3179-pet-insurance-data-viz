{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#FBFAF7",
  "config": {
    "font": "Arial",
    "background": "#FBFAF7",
    "title": {
      "font": "Georgia",
      "fontSize": 22,
      "fontWeight": "normal",
      "anchor": "start",
      "color": "#173A52",
      "subtitleFont": "Arial",
      "subtitleFontSize": 13,
      "subtitleColor": "#687988",
      "offset": 14
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#536979",
      "titleColor": "#334F63",
      "orient": "top",
      "direction": "horizontal",
      "padding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Arial",
      "color": "#173A52"
    }
  },
  "title": {
    "text": "What fills Australia’s 31.6 million pet population?",
    "subtitle": "Tile area shows animal counts; household ownership overlaps."
  },
  "description": "Treemap area is proportional to the estimated number of animals in each pet category. The total is extrapolated from the 2025 national survey using ABS population and household estimates. Household shares overlap because a household can own several pet types.",
  "data": {
    "url": "../data/ama_pet_population_treemap_layout.csv",
    "format": {
      "type": "csv"
    }
  },
  "width": 650,
  "height": 420,
  "transform": [
    {
      "calculate": "toNumber(datum.x0)",
      "as": "x_start"
    },
    {
      "calculate": "toNumber(datum.x1)",
      "as": "x_end"
    },
    {
      "calculate": "toNumber(datum.y0)",
      "as": "y_start"
    },
    {
      "calculate": "toNumber(datum.y1)",
      "as": "y_end"
    },
    {
      "calculate": "(datum.x_end-datum.x_start)*(datum.y_end-datum.y_start)",
      "as": "box_area"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FBFAF7",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x_start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x_end"
        },
        "y": {
          "field": "y_start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y_end"
        },
        "color": {
          "field": "pet_type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Dogs",
              "Cats",
              "Fish",
              "Birds",
              "Small mammals",
              "Reptiles",
              "Other pets"
            ],
            "range": [
              "#1F5AA6",
              "#A33F73",
              "#168C85",
              "#63A4C7",
              "#8C6BB1",
              "#6D8392",
              "#B08AA3"
            ]
          },
          "legend": {
            "title": "Pet type",
            "orient": "top",
            "direction": "horizontal",
            "columns": 4
          }
        },
        "tooltip": [
          {
            "field": "pet_type",
            "type": "nominal",
            "title": "Pet type"
          },
          {
            "field": "animal_millions",
            "type": "quantitative",
            "title": "Animals (millions)",
            "format": ".2f"
          },
          {
            "field": "household_penetration_pct",
            "type": "quantitative",
            "title": "Households with this pet (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.box_area > 450"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "align": "left",
        "baseline": "top",
        "dx": 8,
        "dy": 8,
        "limit": 155
      },
      "encoding": {
        "x": {
          "field": "x_start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y_start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "pet_type"
        },
        "color": {
          "condition": {
            "test": "datum.pet_type === 'Birds'",
            "value": "#FFFFFF"
          },
          "value": "#FFFFFF"
        },
        "tooltip": [
          {
            "field": "pet_type",
            "type": "nominal",
            "title": "Pet type"
          },
          {
            "field": "animal_millions",
            "type": "quantitative",
            "title": "Animals (millions)",
            "format": ".2f"
          },
          {
            "field": "household_penetration_pct",
            "type": "quantitative",
            "title": "Households with this pet (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.box_area > 450"
        },
        {
          "calculate": "format(toNumber(datum.animal_millions), \".2f\") + \"m\"",
          "as": "animal_label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "align": "left",
        "baseline": "top",
        "dx": 8,
        "dy": 28
      },
      "encoding": {
        "x": {
          "field": "x_start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "y_start",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "animal_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.pet_type === 'Birds'",
            "value": "#FFFFFF"
          },
          "value": "#FFFFFF"
        },
        "tooltip": [
          {
            "field": "pet_type",
            "type": "nominal",
            "title": "Pet type"
          },
          {
            "field": "animal_millions",
            "type": "quantitative",
            "title": "Animals (millions)",
            "format": ".2f"
          },
          {
            "field": "household_penetration_pct",
            "type": "quantitative",
            "title": "Households with this pet (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.box_area <= 450"
        },
        {
          "calculate": "(datum.x_start + datum.x_end) / 2",
          "as": "tile_center_x"
        },
        {
          "calculate": "(datum.y_start + datum.y_end) / 2",
          "as": "tile_center_y"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle",
        "dy": -8,
        "color": "#FFFFFF"
      },
      "encoding": {
        "x": {
          "field": "tile_center_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "tile_center_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "pet_type",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "pet_type",
            "type": "nominal",
            "title": "Pet type"
          },
          {
            "field": "animal_millions",
            "type": "quantitative",
            "title": "Animals (millions)",
            "format": ".2f"
          },
          {
            "field": "household_penetration_pct",
            "type": "quantitative",
            "title": "Households with this pet (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.box_area <= 450"
        },
        {
          "calculate": "(datum.x_start + datum.x_end) / 2",
          "as": "tile_center_x"
        },
        {
          "calculate": "(datum.y_start + datum.y_end) / 2",
          "as": "tile_center_y"
        },
        {
          "calculate": "format(toNumber(datum.animal_millions), '.2f') + 'm'",
          "as": "animal_label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "align": "center",
        "baseline": "middle",
        "dy": 8,
        "color": "#FFFFFF"
      },
      "encoding": {
        "x": {
          "field": "tile_center_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "y": {
          "field": "tile_center_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "animal_label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "pet_type",
            "type": "nominal",
            "title": "Pet type"
          },
          {
            "field": "animal_millions",
            "type": "quantitative",
            "title": "Animals (millions)",
            "format": ".2f"
          },
          {
            "field": "household_penetration_pct",
            "type": "quantitative",
            "title": "Households with this pet (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}
