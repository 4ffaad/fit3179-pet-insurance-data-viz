{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#FBFAF7",
  "config": {
    "font": "Arial",
    "background": "#FBFAF7",
    "title": {
      "font": "Georgia",
      "fontSize": 22,
      "fontWeight": "normal",
      "anchor": "start",
      "color": "#173A52",
      "subtitleFont": "Arial",
      "subtitleFontSize": 13,
      "subtitleColor": "#687988",
      "offset": 14
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#536979",
      "titleColor": "#334F63",
      "orient": "top",
      "direction": "horizontal",
      "padding": 4
    }
  },
  "title": {
    "text": "Australian household pet ownership",
    "subtitle": "73% own a pet; 27% do not · rounded to whole percentages."
  },
  "data": {
    "url": "../data/ama_household_waffle_2025.csv",
    "format": {
      "type": "csv"
    }
  },
  "width": 520,
  "height": 420,
  "mark": {
    "type": "rect",
    "cornerRadius": 4
  },
  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "sort": "ascending",
      "axis": {
        "labels": false,
        "ticks": false,
        "domain": false,
        "grid": false,
        "title": ""
      },
      "scale": {
        "paddingInner": 0.08
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "ascending",
      "axis": {
        "labels": false,
        "ticks": false,
        "domain": false,
        "grid": false,
        "title": ""
      },
      "scale": {
        "paddingInner": 0.08
      }
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": ["Pet-owning household", "Household without a pet"],
        "range": ["#176B87", "#D8E0E5"]
      },
      "legend": {
        "title": "Australian households",
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "status",
        "type": "nominal",
        "title": "Household type"
      },
      {
        "field": "share_pct",
        "type": "quantitative",
        "title": "Rounded share (%)",
        "format": ".0f"
      }
    ]
  }
}
