{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#FBFAF7",
  "config": {
    "font": "Arial",
    "background": "#FBFAF7",
    "title": {
      "font": "Georgia",
      "fontSize": 22,
      "fontWeight": "normal",
      "anchor": "start",
      "color": "#173A52",
      "subtitleFont": "Arial",
      "subtitleFontSize": 13,
      "subtitleColor": "#687988",
      "offset": 14
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#5B6F7E",
      "titleColor": "#334F63",
      "domainColor": "#D4DEE4",
      "tickColor": "#D4DEE4",
      "gridColor": "#E8EDF0",
      "gridOpacity": 0.9,
      "labelLimit": 260,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#536979",
      "titleColor": "#334F63",
      "orient": "top",
      "direction": "horizontal",
      "padding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Arial",
      "color": "#173A52"
    },
    "facet": {
      "spacing": 28
    }
  },
  "title": {
    "text": "Australian household pet ownership",
    "subtitle": "73% own a pet; 27% do not · rounded to whole percentages."
  },
  "description": "Each tile represents one percentage point in the 2025 headline estimate, not one household. The detailed table totals 99.8% after rounding.",
  "data": {
    "url": "../data/ama_household_waffle_2025.csv",
    "format": {
      "type": "csv"
    }
  },
  "width": 520,
  "height": 420,
  "mark": {
    "type": "rect",
    "cornerRadius": 4,
    "stroke": "#FBFAF7",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null,
      "scale": {
        "paddingInner": 0.08,
        "paddingOuter": 0.02
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null,
      "scale": {
        "paddingInner": 0.08,
        "paddingOuter": 0.02
      }
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Pet-owning household",
          "Household without a pet"
        ],
        "range": [
          "#176B87",
          "#D8E0E5"
        ]
      },
      "legend": {
        "title": "Australian households",
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "status",
        "type": "nominal",
        "title": "Household type"
      },
      {
        "field": "share_pct",
        "type": "quantitative",
        "title": "Rounded share (%)",
        "format": ".0f"
      }
    ]
  }
}
