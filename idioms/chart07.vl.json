        "type": "rect",
        "stroke": "#FBFAF7",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x_left",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.25,
              4.25
