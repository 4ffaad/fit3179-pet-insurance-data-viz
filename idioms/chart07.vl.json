        "color": {
          "field": "species",
          "type": "nominal",
          "scale": {
            "domain": [
              "Dog",
              "Cat"
            ],
            "range": [
              "#1F5AA6",
              "#A33F73"
            ]
          }
        },
        "tooltip": [
