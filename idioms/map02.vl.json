{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where PetSure recorded motor-vehicle and bike incident claims",
    "subtitle": "Reported 2024 insured claims · circle area is count; state populations and insured-pet counts are not denominators."
  },
  "background": "#FBFAF7",
  "width": 720,
  "height": 490,
  "projection": {
    "type": "albers",
    "rotate": [
      -134,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": 600
  },
  "config": {
    "font": "Arial",
    "background": "#FBFAF7",
    "title": {
      "font": "Georgia",
      "fontSize": 22,
      "fontWeight": "normal",
      "anchor": "start",
      "color": "#20394B",
      "subtitleFont": "Arial",
      "subtitleFontSize": 13,
      "subtitleColor": "#687988",
      "offset": 14
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#536979",
      "titleColor": "#314A5D",
      "orient": "top",
      "direction": "horizontal",
      "padding": 4
    }
  },
  "layer": [
    {
      "data": {
        "url": "../data/australian_states_2026.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E6E9EB",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.1
      }
    },
    {
      "data": {
        "url": "../data/petsure_traffic_incidents_2024.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.longitude)",
          "as": "lon"
        },
        {
          "calculate": "toNumber(datum.latitude)",
          "as": "lat"
        },
        {
          "calculate": "toNumber(datum.incident_claims)",
          "as": "claims"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.86,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "claims",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              420
            ],
            "range": [
              24,
              1650
            ]
          },
          "legend": {
            "title": "PetSure claims (2024)",
            "orient": "top",
            "values": [
              4,
              24,
              78,
              158,
              269,
              331,
              420
            ]
          }
        },
        "color": {
          "value": "#B14D8E"
        },
        "order": {
          "field": "claims",
          "type": "quantitative",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "claims",
            "type": "quantitative",
            "title": "2024 claims",
            "format": "d"
          },
          {
            "field": "scope",
            "type": "nominal",
            "title": "Scope"
          }
        ]
      }
    }
  ]
}
