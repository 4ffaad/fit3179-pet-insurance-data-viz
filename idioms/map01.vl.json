{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average dog-insurance quotes vary by state",
    "subtitle": "Annual quotes in Compare the Market’s March 2025–March 2026 sample · dollars, not policy uptake."
  },
  "description": "Choropleth of average annual dog quote prices in a 16,652-quote panel. AMA does not publish a full comparable state ownership table. Values are not state-wide market averages.",
  "background": "#FBFAF7",
  "width": 720,
  "height": 490,
  "projection": {
    "type": "albers",
    "rotate": [
      -134,
      0
    ],
    "center": [
      0,
      -27
    ],
    "parallels": [
      -18,
      -36
    ],
    "scale": 600
  },
  "config": {
    "font": "Arial",
    "background": "#FBFAF7",
    "title": {
      "font": "Georgia",
      "fontSize": 22,
      "fontWeight": "normal",
      "anchor": "start",
      "color": "#20394B",
      "subtitleFont": "Arial",
      "subtitleFontSize": 13,
      "subtitleColor": "#687988",
      "offset": 14
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#596B79",
      "titleColor": "#334F63",
      "domainColor": "#D4DEE4",
      "tickColor": "#D4DEE4",
      "gridColor": "#E8EDF0",
      "gridOpacity": 0.9,
      "labelLimit": 260,
      "titlePadding": 10
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#536979",
      "titleColor": "#314A5D",
      "orient": "top",
      "direction": "horizontal",
      "padding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Arial",
      "color": "#20394B"
    },
    "facet": {
      "spacing": 28
    }
  },
  "data": {
    "url": "../data/australian_states_2026.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME_2026",
      "from": {
        "data": {
          "url": "../data/compare_market_state_quotes_2026.csv",
          "format": {
            "type": "csv"
          }
        },
        "key": "state",
        "fields": [
          "annual_dog_quote_aud",
          "annual_cat_quote_aud",
          "dog_minus_cat_aud",
          "period",
          "scope"
        ]
      }
    },
    {
      "calculate": "toNumber(datum.annual_dog_quote_aud)",
      "as": "dog_quote"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 1.1
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "isValid(datum.dog_quote)",
        "field": "dog_quote",
        "type": "quantitative",
        "scale": {
          "domain": [
            1050,
            1400
          ],
          "range": [
            "#F3E0F7",
            "#E0C2EF",
            "#C8A5E4",
            "#AA8BD4",
            "#8871BE",
            "#63589F"
          ]
        },
        "legend": {
          "title": "Annual dog quote (AUD)",
          "orient": "top",
          "format": "$,d"
        }
      },
      "value": "#D7DEE3"
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME_2026",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "dog_quote",
        "type": "quantitative",
        "title": "Average annual dog quote (AUD)",
        "format": "$,d"
      },
      {
        "field": "annual_cat_quote_aud",
        "type": "quantitative",
        "title": "Average annual cat quote (AUD)",
        "format": "$,d"
      },
      {
        "field": "period",
        "type": "nominal",
        "title": "Quote sample period"
      },
      {
        "field": "scope",
        "type": "nominal",
        "title": "Interpretation"
      }
    ]
  }
}
