{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Selangor in Peninsular Malaysia",
  "description": "Geographic context focused on Peninsular Malaysia, shown with the cylindrical Mercator projection, nearby country boundaries and a two-degree graticule. Selangor is highlighted for location only; no national survey findings are encoded.",
  "params": [
    {
      "name": "selected_district",
      "value": "All districts"
    }
  ],
  "background": "#FFFFFF",
  "projection": {
    "type": "mercator",
    "center": [
      102.0,
      4.3
    ],
    "scale": 5200
  },
  "width": "container",
  "height": 610,
  "layer": [
    {
      "data": {
        "url": "../data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": {
            "field": "properties.ADMIN",
            "oneOf": [
              "Thailand",
              "Indonesia",
              "Singapore"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#F1F3F4",
        "stroke": "#B9C4CC",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": {
          "field": "properties.ADMIN",
          "type": "nominal",
          "title": "Country"
        }
      }
    },
    {
      "data": {
        "url": "../data/malaysia_peninsula_10m.topojson",
        "format": {
          "type": "topojson",
          "feature": "malaysia_peninsula"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E4EDF3",
        "stroke": "#A7BAC8",
        "strokeWidth": 1.1
      },
      "encoding": {
        "tooltip": {
          "value": "Peninsular Malaysia"
        }
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            2,
            2
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#DCE4E9",
        "strokeWidth": 0.65,
        "opacity": 0.68,
        "strokeDash": [
          3,
          3
        ]
      }
    },
    {
      "data": {
        "url": "../data/selangor_districts.topojson",
        "format": {
          "type": "topojson",
          "feature": "selangor_districts"
        }
      },
      "mark": {
        "type": "geoshape",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "selected_district === 'All districts' || datum.properties.district_join === selected_district",
            "value": "#3976A8"
          },
          "value": "#A9C4DA"
        },
        "stroke": {
          "condition": {
            "test": "selected_district !== 'All districts' && datum.properties.district_join === selected_district",
            "value": "#1D4F7A"
          },
          "value": "#FFFFFF"
        },
        "tooltip": {
          "field": "properties.district_join",
          "type": "nominal",
          "title": "Selangor district"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 101.5,
            "latitude": 6.9,
            "label": "Thailand",
            "kind": "land"
          },
          {
            "longitude": 99.65,
            "latitude": 3.2,
            "label": "Strait of Malacca",
            "kind": "water"
          },
          {
            "longitude": 105.0,
            "latitude": 4.55,
            "label": "South China Sea",
            "kind": "water"
          },
          {
            "longitude": 103.85,
            "latitude": 1.1,
            "label": "Singapore",
            "kind": "land"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "land",
              "water"
            ],
            "range": [
              "#536678",
              "#3976A8"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 102.15,
            "latitude": 3.35,
            "label": "Selangor"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": 700,
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "dy": -2,
        "color": "#1D4F7A"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ]
}
