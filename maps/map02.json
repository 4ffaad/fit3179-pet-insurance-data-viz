{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Study participants by district",
  "description": "Proportional-symbol map of district respondent counts in the Selangor pet-insurance study. Circle area represents count. Select a district on the page to highlight it across the district maps.",
  "params": [
    {
      "name": "selected_district",
      "value": "All districts"
    }
  ],
  "background": "#FFFFFF",
  "projection": {
    "type": "mercator",
    "center": [
      101.5,
      3.2
    ],
    "scale": 22000
  },
  "width": "container",
  "height": 460,
  "layer": [
    {
      "data": {
        "url": "../data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": {
            "field": "properties.ADMIN",
            "oneOf": [
              "Malaysia",
              "Thailand",
              "Indonesia",
              "Brunei"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#F0F2F4",
        "stroke": "#ffffff",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "graticule": {
          "extent": [
            [
              100,
              2
            ],
            [
              103,
              4.5
            ]
          ],
          "step": [
            1,
            1
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#B8C6D5",
        "strokeWidth": 0.55,
        "strokeDash": [
          3,
          3
        ]
      }
    },
    {
      "data": {
        "url": "../data/selangor_districts.topojson",
        "format": {
          "type": "topojson",
          "feature": "selangor_districts"
        }
      },
      "transform": [
        {
          "lookup": "properties.district_join",
          "from": {
            "data": {
              "url": "../data/district_context.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "district",
            "fields": [
              "respondents_n"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.respondents_n)",
          "as": "respondent_count"
        },
        {
          "calculate": "datum.properties.centroid_lon",
          "as": "centroid_longitude"
        },
        {
          "calculate": "datum.properties.centroid_lat",
          "as": "centroid_latitude"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "geoshape"
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "datum.respondent_count === 0",
                "value": "#D8DEE6"
              },
              "value": "#EAF0F6"
            },
            "stroke": {
              "condition": {
                "test": "selected_district !== 'All districts' && datum.properties.district_join === selected_district",
                "value": "#1D4F7A"
              },
              "value": "#ffffff"
            },
            "strokeWidth": {
              "condition": {
                "test": "selected_district !== 'All districts' && datum.properties.district_join === selected_district",
                "value": 2.2
              },
              "value": 1.3
            },
            "tooltip": {
              "field": "properties.district_join",
              "type": "nominal",
              "title": "District"
            }
          }
        },
        {
          "mark": {
            "type": "circle",
            "color": "#3976A8"
          },
          "encoding": {
            "longitude": {
              "field": "centroid_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "centroid_latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "respondent_count",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  42
                ],
                "range": [
                  0,
                  900
                ]
              },
              "legend": {
                "title": "Study respondents",
                "format": "d",
                "orient": "bottom",
                "symbolType": "circle"
              }
            },
            "opacity": {
              "condition": {
                "test": "selected_district === 'All districts' || datum.properties.district_join === selected_district",
                "value": 0.9
              },
              "value": 0.2
            },
            "stroke": {
              "condition": {
                "test": "selected_district !== 'All districts' && datum.properties.district_join === selected_district",
                "value": "#1D4F7A"
              },
              "value": "#ffffff"
            },
            "strokeWidth": {
              "condition": {
                "test": "selected_district !== 'All districts' && datum.properties.district_join === selected_district",
                "value": 2.2
              },
              "value": 1.5
            },
            "tooltip": [
              {
                "field": "properties.district_join",
                "type": "nominal",
                "title": "District"
              },
              {
                "field": "respondent_count",
                "type": "quantitative",
                "title": "Study respondents",
                "format": "d"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.respondent_count === 0"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "dy": -11,
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#24364B"
          },
          "encoding": {
            "longitude": {
              "field": "centroid_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "centroid_latitude",
              "type": "quantitative"
            },
            "text": {
              "value": "No respondents",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Georgia",
      "fontSize": 19,
      "fontWeight": 700,
      "anchor": "start",
      "color": "#1D4F7A",
      "offset": 10
    },
    "text": {
      "font": "Arial",
      "color": "#24364B"
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#536678",
      "titleColor": "#24364B",
      "domainColor": "#D8E0E7",
      "tickColor": "#D8E0E7",
      "gridColor": "#E8EDF2",
      "gridOpacity": 0.68
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#536678",
      "titleColor": "#24364B"
    }
  }
}
