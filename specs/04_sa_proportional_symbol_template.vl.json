{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Recorded animals by SA council \u2014 proportional symbols",
  "description": "Symbols are anchored at geometry-derived representative points; they are not animal locations.",
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
                  "url": "data/sa_lga_simplified.topojson",
                  "format": {
                    "type": "topojson",
                    "feature": "sa_lgas"
                  }
                },
      "mark": {
        "type": "geoshape",
        "fill": "#F2F4F7",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "web_data/sa_council_representative_points.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.72,
        "stroke": "white",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "total_animals",
          "type": "quantitative",
          "title": "Recorded animals",
          "scale": {
            "range": [
              20,
              1600
            ]
          }
        },
        "color": {
          "field": "registered_rate_pct",
          "type": "quantitative",
          "title": "Registered share (%)"
        },
        "tooltip": [
          {
            "field": "council_source_name",
            "type": "nominal",
            "title": "Council"
          },
          {
            "field": "total_animals",
            "type": "quantitative",
            "title": "Recorded animals",
            "format": ",d"
          },
          {
            "field": "registered_rate_pct",
            "type": "quantitative",
            "title": "Registered share (%)",
            "format": ".2f"
          }
        ]
      }
    }
  ]
}