{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Australian households with at least one pet",
  "description": "AMA national survey waves; 2025 reference point is March 2025.",
  "data": {
    "url": "web_data/ama_ownership_trend.csv"
  },
  "mark": {
    "type": "line",
    "point": true,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "temporal",
      "title": "Survey year"
    },
    "y": {
      "field": "household_pet_ownership_pct",
      "type": "quantitative",
      "title": "Households with a pet (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "temporal",
        "title": "Year"
      },
      {
        "field": "household_pet_ownership_pct",
        "type": "quantitative",
        "title": "Households (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Aptos",
      "titleFont": "Aptos"
    },
    "title": {
      "font": "Aptos Display"
    }
  }
}